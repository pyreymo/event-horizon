<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.3.1</Version>
    <PackageProjectUrl>https://github.com/pyreymo/event-horizon</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Localization\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
    <Content Include="Assets\no-binder.avfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
    <Content Include="Assets\no-binder-priority.avfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
    <EmbeddedResource Include="Assets\gaze-marker.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libraries\Underpaint\Underpaint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0">
      <ExcludeAssets Condition="'$(Configuration)' == 'Debug'">runtime</ExcludeAssets>
      <ExcludeAssets Condition="'$(Configuration)' != 'Debug'">all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0">
      <ExcludeAssets Condition="'$(Configuration)' != 'Debug'">all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
